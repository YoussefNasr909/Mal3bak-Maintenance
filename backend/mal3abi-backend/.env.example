# Server Configuration
PORT=4000
NODE_ENV=development # development | production | test
BACKEND_URL=http://localhost:4000 # Use public domain/tunnel in staging/production

# Frontend Client URLs (CORS)
FRONTEND_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/mal3abk?schema=public"

# Authentication & JWT
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
ACCESS_TOKEN_COOKIE=mal3abi_access_token
REFRESH_TOKEN_COOKIE=mal3abi_refresh_token

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Email & Notifications (Brevo / SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="Mal3bk <no-reply@mal3bk.com>"

# Web Push VAPID Keys
WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_CONTACT_EMAIL=no-reply@mal3bk.com

# Timezone
TZ="Africa/Cairo"

# Paymob Payment Gateway Configuration (Egypt)
# Toggle between Sandbox (https://accept.paymob.com) and Live mode keys
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_SECRET_KEY=egy_sk_test_... # or egy_sk_live_...
PAYMOB_PUBLIC_KEY=egy_pk_test_... # or egy_pk_live_...
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_hex
PAYMOB_INTEGRATION_ID_CARD=5835543
PAYMOB_INTEGRATION_ID_WALLET=5835572
PAYMOB_INTEGRATION_ID_UIG=5835572
# PAYMOB_INTEGRATION_ID_APPLE_PAY=your_apple_pay_id # Live mode only
