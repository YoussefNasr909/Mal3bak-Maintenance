# ============================================================
# Mal3abk Backend — Production Environment Template
# ============================================================
# Copy this to .env.production and fill in all values.
# NEVER commit the filled-in .env.production to version control.
# ============================================================

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
BACKEND_URL=https://your-production-domain.com

# Frontend (CORS)
FRONTEND_URL=https://your-production-domain.com
PUBLIC_FRONTEND_URL=https://your-production-domain.com
CORS_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# Database (must include ?sslmode=require for remote databases)
DATABASE_URL="postgresql://user:password@host:5432/mal3abk?schema=public&sslmode=require"

# Authentication & JWT
JWT_SECRET=generate_a_strong_random_hex_string_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_a_different_strong_random_hex_string_min_64_chars
ACCESS_TOKEN_COOKIE=mal3abi_access_token
REFRESH_TOKEN_COOKIE=mal3abi_refresh_token

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo / SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mal3bk <no-reply@mal3bk.com>"

# Web Push VAPID Keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=no-reply@mal3bk.com

# Timezone
TZ="Africa/Cairo"

# Paymob Payment Gateway — LIVE MODE
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=egy_sk_live_...
PAYMOB_PUBLIC_KEY=egy_pk_live_...
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_APPLE_PAY=
# Minutes before a non-final provider response creates a durable urgent admin incident.
PAYMOB_RECONCILIATION_ALERT_AFTER_MINUTES=20

# Optional: Rate limit bypass IPs (comma-separated)
# RATE_LIMIT_SKIP_IPS=

# Optional: Run prisma migrate deploy on start (set to true for first deploy)
# RUN_PRISMA_MIGRATE_DEPLOY=true
